# Copy to local/.env (the local directory is ignored by Git).
DATALAKE_BASE_URL=https://datalake.prophet-lab.cn
DATALAKE_API_KEY=
DATALAKE_PROJECT=investor-last-exam
DATALAKE_PURPOSE=research

# Protocol: chat | responses | anthropic. Names are not restricted to a vendor list.
SOLVER_MODEL=
SOLVER_BASE_URL=
SOLVER_API_KEY=
SOLVER_PROTOCOL=chat
SOLVER_REASONING_PROTOCOL=generic
SOLVER_REASONING_EFFORT=
SOLVER_CONTEXT_WINDOW_TOKENS=131072
SOLVER_MAX_OUTPUT_TOKENS=32768
SOLVER_TEMPERATURE=
SOLVER_TOP_P=
SOLVER_STREAM=true
SOLVER_TIMEOUT_SECONDS=900
SOLVER_MAX_RETRIES=3
SOLVER_SUPPORTS_IMAGES=false
SOLVER_EXTRA_BODY={}
SOLVER_EXTRA_HEADERS={}

# Reader defaults to the solver connection. Set false to configure it separately.
READER_REUSE_SOLVER=true
READER_MODEL=
READER_BASE_URL=
READER_API_KEY=
READER_PROTOCOL=chat
READER_REASONING_PROTOCOL=generic
READER_REASONING_EFFORT=
READER_CONTEXT_WINDOW_TOKENS=131072
READER_MAX_OUTPUT_TOKENS=16384
READER_TEMPERATURE=
READER_TOP_P=
READER_STREAM=true
READER_TIMEOUT_SECONDS=900
READER_MAX_RETRIES=3
READER_SUPPORTS_IMAGES=false
READER_EXTRA_BODY={}
READER_EXTRA_HEADERS={}

# Exactly 1–3 independent judges. No voting, averaging or cross-judge feedback.
JUDGE_COUNT=1
# prompt: schema in prompt (all protocols); native: API structured-output support.
JUDGE_JSON_MODE=prompt
JUDGE_1_MODEL=
JUDGE_1_BASE_URL=
JUDGE_1_API_KEY=
JUDGE_1_PROTOCOL=chat
JUDGE_1_REASONING_PROTOCOL=generic
JUDGE_1_REASONING_EFFORT=
JUDGE_1_CONTEXT_WINDOW_TOKENS=131072
JUDGE_1_MAX_OUTPUT_TOKENS=32768
JUDGE_1_TEMPERATURE=
JUDGE_1_TOP_P=
JUDGE_1_STREAM=true
JUDGE_1_TIMEOUT_SECONDS=900
JUDGE_1_MAX_RETRIES=3
JUDGE_1_EXTRA_BODY={}
JUDGE_1_EXTRA_HEADERS={}

JUDGE_2_MODEL=
JUDGE_2_BASE_URL=
JUDGE_2_API_KEY=
JUDGE_2_PROTOCOL=chat
JUDGE_2_REASONING_PROTOCOL=generic
JUDGE_2_REASONING_EFFORT=
JUDGE_2_CONTEXT_WINDOW_TOKENS=131072
JUDGE_2_MAX_OUTPUT_TOKENS=32768
JUDGE_2_TEMPERATURE=
JUDGE_2_TOP_P=
JUDGE_2_STREAM=true
JUDGE_2_TIMEOUT_SECONDS=900
JUDGE_2_MAX_RETRIES=3
JUDGE_2_EXTRA_BODY={}
JUDGE_2_EXTRA_HEADERS={}

JUDGE_3_MODEL=
JUDGE_3_BASE_URL=
JUDGE_3_API_KEY=
JUDGE_3_PROTOCOL=chat
JUDGE_3_REASONING_PROTOCOL=generic
JUDGE_3_REASONING_EFFORT=
JUDGE_3_CONTEXT_WINDOW_TOKENS=131072
JUDGE_3_MAX_OUTPUT_TOKENS=32768
JUDGE_3_TEMPERATURE=
JUDGE_3_TOP_P=
JUDGE_3_STREAM=true
JUDGE_3_TIMEOUT_SECONDS=900
JUDGE_3_MAX_RETRIES=3
JUDGE_3_EXTRA_BODY={}
