# Solver trial budgets. The paper uses 7200 seconds and three submit attempts.
ILE_CONCURRENCY=1
ILE_WALL_CLOCK_SECONDS=7200
ILE_COMPACTION_RATIO=0.85
ILE_RECENT_MESSAGES=12
ILE_MAX_TOOL_CALLS_PER_RESPONSE=16
ILE_MAX_MALFORMED_CORRECTIONS=5
HARBOR_TELEMETRY=0
